FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Kein JRE noetig — eigenstaendiges GraalVM-Native-Binary.
# poppler-utils + imagemagick bleiben (PDF-Vorschau/Thumbnails).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      poppler-utils \
      imagemagick; \
    rm -rf /var/lib/apt/lists/*; \
    sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' /etc/ImageMagick-6/policy.xml

# Unprivilegierter Benutzer (REQ-0050). Numerische UID, damit Kubernetes runAsNonRoot
# pruefen kann; HOME=/tmp bleibt das einzige Verzeichnis, in das der Dienst schreibt.
RUN useradd --system --uid 10001 --user-group --no-create-home --home-dir /tmp \
      --shell /usr/sbin/nologin blocpress

ENV HOME=/tmp
WORKDIR /app

# GraalVM-Native-Binary (gebaut via: mvn package -Dnative -pl blocpress-workbench -am)
# --chmod statt nachgelagertem RUN chmod: ein eigener chmod-Layer wuerde das komplette
# Binary ein zweites Mal ins Image schreiben (~160 MB). Benoetigt BuildKit.
COPY --chmod=755 target/*-runner /app/application

USER 10001:10001

EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s \
  CMD curl -sf http://localhost:8081/q/health/ready || exit 1
CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]
